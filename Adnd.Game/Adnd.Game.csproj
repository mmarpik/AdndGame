<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Monsters\Level3\" />
    <Folder Include="Assets\Monsters\Level4\" />
    <Folder Include="Assets\Monsters\Level4\" />
    <Folder Include="Input\" />
    <Folder Include="Entities\" />
    <Folder Include="UI\" />
    <Folder Include="World\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Adnd.Core\Adnd.Core.csproj" />
    <ProjectReference Include="..\Adnd.Data\Adnd.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Monsters\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\basilisk.jpg" Link="Assets\Monsters\Level6\basilisk.jpg" />
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\giantant(warrior).png" Link="Assets\Monsters\Level6\giantant%28warrior%29.png" />
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\minotaur.jpg" Link="Assets\Monsters\Level6\minotaur.jpg" />
    <Content Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\wraith.png" Link="Assets\Monsters\Level6\wraith.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\..\..\dev\Images\Monsters\Level6\giant crocodile.webp" Link="Assets\Monsters\Level6\giant crocodile.webp" />
  </ItemGroup>

</Project>
